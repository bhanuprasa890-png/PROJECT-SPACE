# ---------------------------------------------------------------------------
# TransitPulse AI — environment configuration
# Copy to `.env` and fill in. Every value has a working demo default.
# ---------------------------------------------------------------------------

# --- API server -------------------------------------------------------------
PORT=8787
NODE_ENV=development

# --- Database ---------------------------------------------------------------
# Option A (production / Supabase): point TransitPulse at your Supabase Postgres
# instance. Use the "Connection string" from
#   Supabase dashboard -> Project Settings -> Database -> Connection string
#   (Session pooler works best from serverless environments.)
# The app runs the SQL in supabase/migrations + supabase/seed.sql automatically.
#
# DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
DB_SSL=true

# Option B (default, zero-config): an embedded PostgreSQL (PGlite) database is
# created at .data/transitpulse with the exact same migrations and seed data, so
# the hackathon demo boots with no credentials at all.
PGLITE_DIR=.data/transitpulse

# Always (re)apply migrations + seed data on boot. Leave true for demos.
DB_AUTO_MIGRATE=true
DB_RESET=false

# --- Frontend (only needed if you want the browser to talk to Supabase
#     directly, e.g. for realtime subscriptions). The app works fully through
#     the Express API, so these are optional.
# VITE_SUPABASE_URL=https://<project-ref>.supabase.co
# VITE_SUPABASE_ANON_KEY=<anon-key>

# Demo identity used until real Supabase Auth is wired up.
DEFAULT_PROFILE_ID=profile-ava
