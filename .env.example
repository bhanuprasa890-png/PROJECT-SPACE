# ─────────────────────────────────────────────────────────────
# Mise · copy to .env (never committed)
# ─────────────────────────────────────────────────────────────

# HTTP
PORT=8787
HOST=0.0.0.0
NODE_ENV=development

# REQUIRED in production, generated into server/.dev/ in development.
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# SESSION_SECRET=

# Database (defaults to server/.dev/mise.db; ':memory:' is honoured for tests)
# DB_PATH=./server/.dev/mise.db

# ── Sign in with Google ──────────────────────────────────────
# demo (default): the in-app Google account chooser backed by seeded demo
#   accounts. No secrets needed — this is what the sandbox runs.
# live: real Google Identity Services. Create an OAuth 2.0 Client ID for a
#   Web application at https://console.cloud.google.com/apis/credentials,
#   add your origin to "Authorized JavaScript origins", then set:
#     GOOGLE_MODE=live
#     GOOGLE_OAUTH_CLIENT_ID=xxxxxxxx.apps.googleusercontent.com
GOOGLE_MODE=demo
# GOOGLE_OAUTH_CLIENT_ID=

# ── Demo credentials ─────────────────────────────────────────
# The passcode the three seeded Google demo accounts accept.
DEMO_PASSCODE=MiseDemo#2026
# Show/hidden the demo credential panel on the login page (off in prod).
SHOW_DEMO_CREDENTIALS=true

# ── Hardening knobs ──────────────────────────────────────────
# COOKIE_SECURE=true            # auto: on in production
# SESSION_TTL_DAYS=14
# RATE_LIMIT_WINDOW_MS=60000
# RATE_LIMIT_MAX=12
# RATE_LIMIT_MAX_FAILURES=5
# RATE_LIMIT_LOCKOUT_MS=900000
# PASSWORD_MIN_LENGTH=10
