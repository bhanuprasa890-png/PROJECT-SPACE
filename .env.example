# ---------------------------------------------------------------------------
# TransitPulse AI — environment configuration
# Copy to `.env` and fill in. Every value has a working demo default.
#
# SECURITY: this file is read by the API server only. Database credentials are
# never bundled into the browser build — the frontend talks to `/api` and the
# Express server is the only process that holds a database connection. Do not
# add `DATABASE_URL` (or any Supabase service key) to a `VITE_*` variable.
# ---------------------------------------------------------------------------

# --- API server -------------------------------------------------------------
PORT=8787
NODE_ENV=development

# --- Database ---------------------------------------------------------------
# Option A (production / Supabase): point TransitPulse at your Supabase Postgres
# instance. Use the "Connection string" from
#   Supabase dashboard -> Project Settings -> Database -> Connection string
#   (Session pooler works best from serverless environments.)
# The app runs the SQL in supabase/migrations + supabase/seed automatically.
#
# DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
DB_SSL=true

# Option B (default, zero-config): an embedded PostgreSQL (PGlite) database is
# created at .data/transitpulse with the exact same migrations and seed data, so
# the hackathon demo boots with no credentials at all.
PGLITE_DIR=.data/transitpulse

# Always (re)apply migrations + seed data on boot. Leave true for demos.
DB_AUTO_MIGRATE=true
DB_RESET=false

# --- Optional: Supabase project metadata (server-side only) -----------------
# Only needed if a future iteration talks to Supabase Storage / Auth / Realtime
# directly from the API. The service-role key must never be exposed to the
# browser, and the current frontend does not use any of these values.
# SUPABASE_URL=https://<project-ref>.supabase.co
# SUPABASE_ANON_KEY=<anon-key>
# SUPABASE_SERVICE_ROLE_KEY=<service-role-key>

# --- Google Maps Platform ---------------------------------------------------
# TransitPulse draws its own intelligence layer *on top of* real Google Maps.
# Two keys with different restrictions, both optional:
#
#   1. Browser key (Maps JavaScript API). Restrict it to the HTTP referrers your
#      demo runs on (for example `localhost:5173/*`, `<your-preview-host>/*`).
#      The server hands it to the page via GET /api/maps/config, or you can bake
#      it in as VITE_GOOGLE_MAPS_API_KEY at build time. Maps JavaScript API and
#      (for nicer labelled pins) the Maps Static/Geocoding APIs should be enabled.
#
#   2. Server key (Directions API). Restrict it by IP address — it is used only
#      by the API server and is never sent to the browser.
#
# Without keys the app still works: the map panel shows a labelled schematic of
# the network built from the same Postgres geometry and says so on screen.
GOOGLE_MAPS_BROWSER_KEY=
GOOGLE_MAPS_API_KEY=
# Set to false to skip the road-snapped Directions proxy entirely.
GOOGLE_MAPS_DIRECTIONS=true
# Timezone used for service-day maths on the map (defaults to the agency's).
MAPS_TIME_ZONE=Asia/Kolkata

# Build-time browser key (Vite). Same referrer-restricted key as above; prefer
# this only if you cannot set server-side environment variables.
# VITE_GOOGLE_MAPS_API_KEY=

# --- Demo identity ----------------------------------------------------------
# The rider whose dashboard loads by default until Supabase Auth is wired up.
# Seeded profiles: profile-ava (commuter), profile-ops (operator),
# profile-admin (admin).
DEFAULT_PROFILE_ID=profile-ava
