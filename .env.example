# ---------------------------------------------------------------------------
# TransitPulse AI — environment configuration
# Copy to `.env` and fill in. Every value has a working demo default.
#
# SECURITY: this file is read by the API server only. Database credentials are
# never bundled into the browser build — the frontend talks to `/api` and the
# Express server is the only process that holds a database connection. Do not
# add `DATABASE_URL` (or any Supabase service key) to a `VITE_*` variable.
# ---------------------------------------------------------------------------

# --- API server -------------------------------------------------------------
PORT=8787
NODE_ENV=development

# --- Database ---------------------------------------------------------------
# Option A (production / Supabase): point TransitPulse at your Supabase Postgres
# instance. Use the "Connection string" from
#   Supabase dashboard -> Project Settings -> Database -> Connection string
#   (Session pooler works best from serverless environments.)
# The app runs the SQL in supabase/migrations + supabase/seed automatically.
#
# DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
DB_SSL=true

# Option B (default, zero-config): an embedded PostgreSQL (PGlite) database is
# created at .data/transitpulse with the exact same migrations and seed data, so
# the hackathon demo boots with no credentials at all.
PGLITE_DIR=.data/transitpulse

# Always (re)apply migrations + seed data on boot. Leave true for demos.
DB_AUTO_MIGRATE=true
DB_RESET=false

# --- Optional: Supabase project metadata (server-side only) -----------------
# Only needed if a future iteration talks to Supabase Storage / Auth / Realtime
# directly from the API. The service-role key must never be exposed to the
# browser, and the current frontend does not use any of these values.
# SUPABASE_URL=https://<project-ref>.supabase.co
# SUPABASE_ANON_KEY=<anon-key>
# SUPABASE_SERVICE_ROLE_KEY=<service-role-key>

# --- Demo identity ----------------------------------------------------------
# The rider whose dashboard loads by default until Supabase Auth is wired up.
# Seeded profiles: profile-ava (commuter), profile-ops (operator),
# profile-admin (admin).
DEFAULT_PROFILE_ID=profile-ava
