{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "$description": "Single source of truth for Mise. `npm run tokens` generates client/src/styles/tokens.css AND figma/tokens/figma-variables.json (import it in Figma: Select variables → Import from JSON). Light values live in $extensions['com.mise/light'] and become Figma's second mode.",

  "color": {
    "bg": {
      "base": { "$type": "color", "$value": "#100E0C", "$extensions": { "com.mise/light": "#FFFAF4" }, "$description": "Page background" },
      "raise": { "$type": "color", "$value": "#171310", "$extensions": { "com.mise/light": "#FFFFFF" }, "$description": "Cards, sheets" },
      "raise-2": { "$type": "color", "$value": "#1F1A16", "$extensions": { "com.mise/light": "#F6EFE6" }, "$description": "Nested surfaces, inputs" },
      "sunken": { "$type": "color", "$value": "#0A0908", "$extensions": { "com.mise/light": "#EFE7DC" } },
      "brand-wash": { "$type": "color", "$value": "#2A1B12", "$extensions": { "com.mise/light": "#FFF0E2" }, "$description": "Tinted panels (login accent, active chip)" }
    },
    "border": {
      "hairline": { "$type": "color", "$value": "#2C2521", "$extensions": { "com.mise/light": "#EADFD2" } },
      "strong": { "$type": "color", "$value": "#3E342D", "$extensions": { "com.mise/light": "#D6C6B3" } },
      "focus": { "$type": "color", "$value": "#FF8A3D", "$extensions": { "com.mise/light": "#C4571A" }, "$description": "Focus ring — 3px offset style" }
    },
    "text": {
      "hi": { "$type": "color", "$value": "#FFF8F1", "$extensions": { "com.mise/light": "#1A120C" } },
      "mid": { "$type": "color", "$value": "#C9B8AC", "$extensions": { "com.mise/light": "#5C4A3C" } },
      "low": { "$type": "color", "$value": "#8D7C71", "$extensions": { "com.mise/light": "#8A7768" } },
      "inverted": { "$type": "color", "$value": "#1A120C", "$extensions": { "com.mise/light": "#FFFFFF" }, "$description": "Text on inverted surfaces (badges, chips)" },
      "on-accent": { "$type": "color", "$value": "#1A120C", "$description": "Label on the saffron fill — dark in BOTH modes so it stays AA" }
    },
    "accent": {
      "saffron": { "$type": "color", "$value": "#FF8A3D", "$extensions": { "com.mise/light": "#E2600F" }, "$description": "Primary action" },
      "saffron-soft": { "$type": "color", "$value": "#FFD28A", "$extensions": { "com.mise/light": "#F2B44C" } },
      "herb": { "$type": "color", "$value": "#7ED9A6", "$extensions": { "com.mise/light": "#2E9363" }, "$description": "Success, ready state" },
      "chilli": { "$type": "color", "$value": "#FF4D5E", "$extensions": { "com.mise/light": "#D42A3C" }, "$description": "Error, heat" },
      "tamarind": { "$type": "color", "$value": "#C9A2FF", "$extensions": { "com.mise/light": "#7A4FD1" }, "$description": "Ferment / make-ahead copilot" },
      "steam": { "$type": "color", "$value": "#7CC5F7", "$extensions": { "com.mise/light": "#1E7FD1" }, "$description": "Info, timer" }
    },
    "ink": {
      "accent": { "$type": "color", "$value": "#FF8A3D", "$extensions": { "com.mise/light": "#9A3F06" }, "$description": "Accent used AS TEXT on a surface (AA-safe in both modes)" },
      "danger": { "$type": "color", "$value": "#FF7180", "$extensions": { "com.mise/light": "#B01122" }, "$description": "Error text on a surface" },
      "ok": { "$type": "color", "$value": "#8FE3B4", "$extensions": { "com.mise/light": "#1B6B45" }, "$description": "Success text on a surface" }
    },
    "google": {
      "blue": { "$type": "color", "$value": "#4285F4" },
      "red": { "$type": "color", "$value": "#EA4335" },
      "yellow": { "$type": "color", "$value": "#FBBC05" },
      "green": { "$type": "color", "$value": "#34A853" },
      "sheet": { "$type": "color", "$value": "#FFFFFF" },
      "sheet-text": { "$type": "color", "$value": "#202124" },
      "sheet-muted": { "$type": "color", "$value": "#5F6368" },
      "sheet-line": { "$type": "color", "$value": "#DADCE0" }
    }
  },

  "font": {
    "family": {
      "display": { "$type": "fontFamily", "$value": "Sora, 'Trebuchet MS', sans-serif" },
      "body": { "$type": "fontFamily", "$value": "Inter, system-ui, -apple-system, sans-serif" },
      "mono": { "$type": "fontFamily", "$value": "'JetBrains Mono', ui-monospace, monospace" }
    },
    "size": {
      "xs": { "$type": "dimension", "$value": "12px" },
      "sm": { "$type": "dimension", "$value": "13px" },
      "body": { "$type": "dimension", "$value": "15px" },
      "md": { "$type": "dimension", "$value": "17px" },
      "lg": { "$type": "dimension", "$value": "21px" },
      "xl": { "$type": "dimension", "$value": "27px" },
      "2xl": { "$type": "dimension", "$value": "36px" },
      "3xl": { "$type": "dimension", "$value": "52px" }
    },
    "weight": {
      "regular": { "$type": "number", "$value": 400 },
      "medium": { "$type": "number", "$value": 500 },
      "semibold": { "$type": "number", "$value": 600 },
      "bold": { "$type": "number", "$value": 700 }
    },
    "line": {
      "tight": { "$type": "number", "$value": 1.08 },
      "snug": { "$type": "number", "$value": 1.25 },
      "normal": { "$type": "number", "$value": 1.55 },
      "loose": { "$type": "number", "$value": 1.75 }
    },
    "tracking": {
      "display": { "$type": "dimension", "$value": "-1.2px" },
      "eyebrow": { "$type": "dimension", "$value": "1.4px" }
    }
  },

  "size": {
    "space": {
      "1": { "$type": "dimension", "$value": "4px" },
      "2": { "$type": "dimension", "$value": "8px" },
      "3": { "$type": "dimension", "$value": "12px" },
      "4": { "$type": "dimension", "$value": "16px" },
      "5": { "$type": "dimension", "$value": "24px" },
      "6": { "$type": "dimension", "$value": "32px" },
      "7": { "$type": "dimension", "$value": "48px" },
      "8": { "$type": "dimension", "$value": "72px" }
    },
    "radius": {
      "sm": { "$type": "dimension", "$value": "8px" },
      "md": { "$type": "dimension", "$value": "14px" },
      "lg": { "$type": "dimension", "$value": "22px" },
      "pill": { "$type": "dimension", "$value": "999px" }
    },
    "border": {
      "hair": { "$type": "dimension", "$value": "1px" },
      "thick": { "$type": "dimension", "$value": "2px" }
    },
    "control": {
      "height": { "$type": "dimension", "$value": "48px" },
      "height-sm": { "$type": "dimension", "$value": "38px" },
      "icon": { "$type": "dimension", "$value": "20px" },
      "tap-target": { "$type": "dimension", "$value": "44px" }
    }
  },

  "effect": {
    "shadow": {
      "card": { "$type": "shadow", "$value": { "color": "#00000066", "offsetX": "0px", "offsetY": "18px", "blur": "40px" }, "$description": "Resting card" },
      "lift": { "$type": "shadow", "$value": { "color": "#00000099", "offsetX": "0px", "offsetY": "28px", "blur": "70px" }, "$description": "Hover / focus lift" },
      "glow": { "$type": "shadow", "$value": { "color": "#FF8A3D59", "offsetX": "0px", "offsetY": "0px", "blur": "34px" }, "$description": "Primary action halo" }
    },
    "blur": {
      "glass": { "$type": "dimension", "$value": "14px" }
    }
  },

  "motion": {
    "duration": {
      "instant": { "$type": "duration", "$value": "120ms" },
      "fast": { "$type": "duration", "$value": "220ms" },
      "base": { "$type": "duration", "$value": "380ms" },
      "slow": { "$type": "duration", "$value": "640ms" }
    },
    "easing": {
      "out": { "$type": "cubicBezier", "$value": [0.16, 0.84, 0.24, 1] },
      "in-out": { "$type": "cubicBezier", "$value": [0.62, 0, 0.28, 1] },
      "springy": { "$type": "cubicBezier", "$value": [0.34, 1.56, 0.64, 1] }
    },
    "parallax": {
      "card-tilt": { "$type": "number", "$value": 9, "$description": "max deg on pointer move" },
      "card-lift": { "$type": "dimension", "$value": "18px", "$description": "translateZ on hover" }
    }
  }
}
