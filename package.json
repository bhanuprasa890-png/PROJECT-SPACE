{
  "name": "mise-kitchen-copilot",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Mise \u2014 a cooking copilot web app. Login-first, Google sign-in, 3D AI copilots, recipe cards.",
  "workspaces": [
    "server",
    "client"
  ],
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:server": "node --disable-warning=ExperimentalWarning server/src/index.mjs",
    "dev:client": "npm run dev -w client",
    "build": "npm run build -w client",
    "start": "node --disable-warning=ExperimentalWarning server/src/index.mjs",
    "test": "node --disable-warning=ExperimentalWarning --test server/test/*.test.mjs",
    "tokens": "node scripts/gen-tokens.mjs",
    "seed": "node --disable-warning=ExperimentalWarning server/src/seed.mjs --force",
    "smoke": "node scripts/smoke.mjs",
    "contrast": "node scripts/contrast.mjs",
    "test:client": "npm run test -w client",
    "test:all": "npm test && npm run test:client"
  },
  "engines": {
    "node": ">=22.5.0"
  }
}
