{
  "name": "transitpulse-ai",
  "version": "0.1.0",
  "description": "TransitPulse AI \u2014 crowd-aware transit planning (predict \u00b7 avoid \u00b7 optimize)",
  "main": "index.js",
  "scripts": {
    "dev": "concurrently -k -n api,web -c magenta,cyan \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "tsx watch server/index.ts",
    "dev:web": "vite",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0",
    "start": "tsx server/index.ts",
    "typecheck": "tsc --noEmit",
    "db:status": "tsx server/scripts/db.ts status",
    "db:reset": "tsx server/scripts/db.ts reset",
    "db:migrate": "tsx server/scripts/db.ts migrate",
    "db:sql": "tsx server/scripts/db.ts sql",
    "smoke": "node scripts/smoke.mjs",
    "db:verify": "tsx server/scripts/db.ts verify",
    "db:refresh": "tsx server/scripts/db.ts refresh",
    "smoke:maps": "SMOKE_MOCK_MAPS=1 node scripts/smoke.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bhanuprasa890-png/PROJECT-SPACE.git"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/bhanuprasa890-png/PROJECT-SPACE/issues"
  },
  "homepage": "https://github.com/bhanuprasa890-png/PROJECT-SPACE#readme",
  "private": "true",
  "type": "module",
  "dependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@tanstack/react-query": "^5.102.8",
    "clsx": "^2.1.1",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "lucide-react": "^1.44.0",
    "pg": "^8.23.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.18.3",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.6.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/google.maps": "^3.66.2",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^22.20.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^10.0.5",
    "jsdom": "^30.0.1",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2",
    "vite": "^8.3.0"
  }
}
